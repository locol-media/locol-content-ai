  "07137bd4adc6ce71796386ec1765ccc6_0": {
    "author": "Mike Pun",
    "comment": "safe_paths.resolve_within: this IS the containment guard. The flagged os.path.join is immediately realpath'd and rejected unless the result stays under the resolved root, which is what makes every caller safe.",
    "created_at": "2026-08-26T00:00:00Z",
    "false_positive": true
  },
  "07137bd4adc6ce71796386ec1765ccc6_1": {
    "author": "Mike Pun",
    "comment": "safe_paths.list_yaml_files: the flagged os.listdir reads the operator-set config root itself, and every entry it yields is passed back through resolve_within() before use.",
    "created_at": "2026-08-26T00:00:00Z",
    "false_positive": true
  },
  "53bd6244eaefa3aa87698da8d8af7d33_0": {
    "author": "Mike Pun",
    "comment": "projectSurvey.load_page_configs: the flagged join is the guard itself - absolute paths are rejected above it, and the very next line rejects any result that does not stay under question_sets_root.",
    "created_at": "2026-08-26T00:00:00Z",
    "false_positive": true
  },
  "53bd6244eaefa3aa87698da8d8af7d33_1": {
    "author": "Mike Pun",
    "comment": "projectSurvey.load_page_configs: yaml_path was containment-checked against question_sets_root before this open(). config_file comes from a question-set YAML, not from request input.",
    "created_at": "2026-08-26T00:00:00Z",
    "false_positive": true
  },

  "13cc65c22144946d9684da3425bf2479_0": {
    "author": "Mike Pun",
    "comment": "grid-master.js elNew(): generic Object.assign wrapper over createElement. Its only call site passes {className: 'gutter'}; no innerHTML/outerHTML property is ever set through it.",
    "created_at": "2026-08-05T00:00:00Z",
    "false_positive": true
  },
