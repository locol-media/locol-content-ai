# Locol Content AI - optional settings for docker-compose.yml.
#
#   cp .env.example .env        then edit, then: docker compose up -d
#
# Everything here has a working default, so you only need a .env at all if one of the
# ports is taken or you reach the app from another machine. Uncomment what you change.
#
# Compose reads this file to fill in the ${...} references in docker-compose.yml. It is
# not passed into the container, so adding a name here that the compose file does not
# reference has no effect - the ones below are the complete set.
#
# There is no LLM provider key in here on purpose. Set yours in the app, where it is
# encrypted at rest and belongs to your account alone: register, then
# Settings and Tools -> Config Manager -> LLMs -> Locol AI Default -> API Key.


# --- Image -------------------------------------------------------------------

# Which published image to run. A release archive ships with this already pinned to the
# version you downloaded, in docker-compose.yml itself.
#   0.2.0    an exact release - immutable, and what to use if you care about knowing
#            what is running
#   latest   the newest release; moves
#   edge     the newest commit on main; moves, and is not a release
#LOCOL_IMAGE_TAG=latest


# --- Published ports ---------------------------------------------------------

# Ports on THIS MACHINE. The ports inside the container are fixed at 8501 and 8000, so
# changing these remaps rather than reconfigures - there is nothing else to keep in step
# except the two URLs below.
#LOCOL_WEB_PORT=8501
#LOCOL_BACKEND_PORT=8000


# --- URLs --------------------------------------------------------------------

# How your BROWSER reaches the API and the Content Editor. The app hands these URLs to
# the browser, so they have to name the host you are browsing from, with the published
# port from above. Set both together.
#
# Leave them alone for a local install on the default port. Set them if you changed
# LOCOL_BACKEND_PORT, or if the app is on another machine:
#   LOCOL_API_URL=http://192.168.1.10:8000
#   LOCOL_WWW_URL=http://192.168.1.10:8000
#
# Behind a reverse proxy terminating TLS, both are the public https URL. Note the proxy
# needs a read timeout above LOCOL_LLM_REQUEST_TIMEOUT, or it returns a 504 of its own
# before the app can report the timeout itself.
#LOCOL_API_URL=http://localhost:8000
#LOCOL_WWW_URL=http://localhost:8000


# --- Behaviour ---------------------------------------------------------------

# Seconds the web UI waits on a request that triggers an LLM call - brainstorming,
# content generation. These take minutes, not seconds; raise it for slow models rather
# than lowering it.
#LOCOL_LLM_REQUEST_TIMEOUT=180

# Verbose LLM and request logging, in `docker compose logs`. Off unless set to true.
#DEBUG=false
